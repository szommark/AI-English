# --- Client-side (exposed to the browser, must be prefixed with VITE_) ---
# Supabase project URL and anon/public key for THIS app's dedicated Supabase project
# (do not reuse the "Tobb mint angol" project - this is a separate product/database).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Server-side only (Vercel serverless functions, never sent to the client) ---
# Supabase service role key - bypasses RLS, used by /api routes to verify users
# and write session/usage logs. Keep secret.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Groq API key - used only from /api routes. Never expose to the client.
GROQ_API_KEY=

# Gemini API key (Google AI Studio) - powers Tutor Bot's free-form conversation via
# gemini-3.1-flash-lite. Used only from /api routes. Never expose to the client.
GEMINI_API_KEY=

# Azure Speech service (Free F0 tier) - used only from /api routes for the rehearsal
# screen's "Deep check" pronunciation assessment. Never expose to the client; the
# client only ever receives a short-lived token minted by /api/pronunciation-token.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
